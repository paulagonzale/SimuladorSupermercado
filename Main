import java.util.Arrays;

public class Main {

    public static void main(String[] args) {

        Producto p1 = new Producto("Arroz", 5000, 2);
        Producto p2 = new Producto("Leche", 3500, 1);
        Producto p3 = new Producto("Pan", 2500, 3);

        Cliente cliente1 = new Cliente(
                "Carlos",
                Arrays.asList(p1, p2, p3)
        );

        Cliente cliente2 = new Cliente(
                "Ana",
                Arrays.asList(
                        new Producto("Huevos", 12000, 2),
                        new Producto("Café", 15000, 4)
                )
        );

        long tiempoInicial = System.currentTimeMillis();

        Cajera cajera1 = new Cajera(
                "Cajera 1",
                cliente1,
                tiempoInicial
        );

        Cajera cajera2 = new Cajera(
                "Cajera 2",
                cliente2,
                tiempoInicial
        );

        cajera1.start();
        cajera2.start();
    }
}
